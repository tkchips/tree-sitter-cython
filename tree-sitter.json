{
  "grammars": [
    {
      "name": "cython",
      "camelcase": "Cython",
      "scope": "source.cython",
      "path": ".",
      "file-types": [
        "py"
      ],
      "highlights": "queries/highlights.scm",
      "tags": "queries/tags.scm",
      "injection-regex": "cython"
    }
  ],
  "metadata": {
    "version": "0.25.0",
    "license": "MIT",
    "description": "Cython grammar for tree-sitter",
    "authors": [
      {
        "name": "Max Brunsfeld",
        "email": "maxbrunsfeld@gmail.com"
      },
      {
        "name": "Amaan Qureshi",
        "email": "amaanq12@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-cython"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
